# Copy to .env (git-ignored) and replace the values, or generate random ones with scripts/init-env.sh|ps1.
# docker compose refuses to start until these are set, so no credential is ever stored in the repository.
DB_USERNAME=claims
DB_PASSWORD=replace-me
# Password of the demo users (officer-1, officer-2, manager-1, tan@example.com, lee@example.com)
APP_SECURITY_DEMO_PASSWORD=replace-me
